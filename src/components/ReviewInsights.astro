---
/**
 * Rating-distribution bars + review keyword chips.
 * Renders inside/under the rating block on detail pages. Pure build-time data
 * from src/lib/reviewInsights — no runtime JS.
 */
import { ratingHistogram, reviewKeywords, type RawReview } from '../lib/reviewInsights';

interface Props {
  lang: 'es' | 'en' | 'ca';
  reviews: RawReview[];
  reviewCount?: number;
}

const { lang, reviews, reviewCount } = Astro.props;
const hist = ratingHistogram(reviews);
const keywords = reviewKeywords(reviews);

const t = {
  es: {
    distTitle: 'Distribución de valoraciones',
    distHint: `estimada a partir de las reseñas recientes publicadas${reviewCount ? ` de ${reviewCount.toLocaleString('es-ES')} en total` : ''}`,
    kwTitle: 'Lo que más mencionan los clientes',
    kwHint: 'extraído automáticamente de las reseñas de Google',
    reviews: 'reseñas',
  },
  en: {
    distTitle: 'Rating breakdown',
    distHint: `estimated from the recent reviews shown${reviewCount ? ` out of ${reviewCount.toLocaleString('en-US')} total` : ''}`,
    kwTitle: 'What clients mention most',
    kwHint: 'automatically extracted from Google reviews',
    reviews: 'reviews',
  },
  ca: {
    distTitle: 'Distribució de les valoracions',
    distHint: `estimada a partir de les ressenyes recents publicades${reviewCount ? ` de ${reviewCount.toLocaleString('ca-ES')} en total` : ''}`,
    kwTitle: 'El que més mencionen els clients',
    kwHint: 'extret automàticament de les ressenyes de Google',
    reviews: 'ressenyes',
  },
}[lang];

const barColors = ['bg-emerald-500', 'bg-emerald-400', 'bg-lime-400', 'bg-amber-400', 'bg-stone-300'];
const maxShare = hist ? Math.max(...hist.share, 0.0001) : 1;
---

{hist && (
  <div class="mt-4 pt-4 border-t border-stone-200">
    <p class="text-xs font-medium text-stone-500 uppercase tracking-wider">{t.distTitle}</p>
    <p class="text-[11px] text-stone-400 mt-0.5">{t.distHint}</p>
    <div class="mt-2 space-y-1">
      {hist.counts.map((_, idx) => (
        <div class="flex items-center gap-2 text-xs">
          <span class="w-6 text-right text-stone-500 shrink-0">{5 - idx}★</span>
          <div class="flex-1 h-2 rounded-full bg-stone-100 overflow-hidden">
            <div class={`h-full rounded-full ${barColors[idx]}`} style={`width: ${(hist.share[idx] * 100).toFixed(1)}%`}></div>
          </div>
          <span class="w-10 text-stone-400 shrink-0">{Math.round(hist.share[idx] * 100)}%</span>
        </div>
      ))}
    </div>
    <p class="text-[11px] text-stone-400 mt-1.5">{hist.total} {t.reviews}</p>
  </div>
)}

{keywords.length > 0 && (
  <div class={`mt-4 ${hist ? 'pt-4 border-t border-stone-100' : ''}`}>
    <p class="text-xs font-medium text-stone-500 uppercase tracking-wider">{t.kwTitle}</p>
    <p class="text-[11px] text-stone-400 mt-0.5">{t.kwHint}</p>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {keywords.map(k => (
        <span
          class={`text-xs px-2.5 py-1 rounded-full border ${k.positive
            ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
            : 'bg-red-50 text-red-700 border-red-200'}`}
        >
          {k.positive ? '✓' : '⚠'} {lang === 'es' ? k.es : lang === 'ca' ? k.ca : k.en} · {Math.round(k.share * 100)}%
        </span>
      ))}
    </div>
  </div>
)}
