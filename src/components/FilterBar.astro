---
import { neighborhoods, massageTypes, nailServices } from '../data/constants';

interface Props {
  category: 'nails' | 'massage';
  lang?: string;
}

const { category, lang = 'es' } = Astro.props;
const isNails = category === 'nails';
const isEs = lang === 'es';
const isEn = lang === 'en';
const isCa = lang === 'ca';
const categoryPath = isEs ? category : `${lang}/${category}`;

const sortLabel = isEs ? 'Ordenar por' : isCa ? 'Ordenar per' : 'Sort by';
const neighborhoodLabel = isEs ? 'Barrio' : isCa ? 'Barri' : 'Neighborhood';
const priceLabel = isEs ? 'Precio' : isCa ? 'Preu' : 'Price';
const massageTypeLabel = isEs ? 'Tipo de masaje' : isCa ? 'Tipus de massatge' : 'Massage type';
const servicesLabel = isEs ? 'Servicios' : isCa ? 'Serveis' : 'Services';
const searchLabel = isEs ? 'Buscar' : isCa ? 'Cercar' : 'Search';
const searchPlaceholder = isEs
  ? 'Nombre, calle, servicio…'
  : isCa
    ? 'Nom, carrer, servei…'
    : 'Name, street, service…';
const sortRating = isEs ? 'Mejor valorados' : isCa ? 'Millor valorats' : 'Top rated';
const sortReviews = isEs ? 'Más reseñas' : isCa ? 'Més ressenyes' : 'Most reviews';
const sortPriceAsc = isEs ? 'Precio: menor a mayor' : isCa ? 'Preu: de menor a major' : 'Price: low to high';
const sortPriceDesc = isEs ? 'Precio: mayor a menor' : isCa ? 'Preu: de major a menor' : 'Price: high to low';
const allNeighborhoods = isEs ? 'Todos los barrios' : isCa ? 'Tots els barris' : 'All neighborhoods';
const anyOption = isEs ? 'Cualquiera' : isCa ? 'Qualsevol' : 'Any';
const allOption = isEs ? 'Todos' : isCa ? 'Tots' : 'All';
const massageTypeLabelFor = (t: (typeof massageTypes)[number]) => (isEs ? t.es : isCa ? t.ca : t.en);
---

<form id="filters" class="bg-white border border-stone-200 rounded-xl p-4 flex flex-wrap gap-3 items-end" data-category={category}>
  <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
    <label class="text-xs font-medium text-stone-500 uppercase tracking-wider" for="bc-search">{searchLabel}</label>
    <input
      id="bc-search"
      type="search"
      autocomplete="off"
      placeholder={searchPlaceholder}
      class="text-sm border border-stone-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent w-full"
    />
  </div>

  <div class="flex flex-col gap-1 min-w-[140px]">
    <label class="text-xs font-medium text-stone-500 uppercase tracking-wider">{sortLabel}</label>
    <select name="sort" class="text-sm border border-stone-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent">
      <option value="rating">{sortRating}</option>
      <option value="reviews">{sortReviews}</option>
      <option value="price_asc">{sortPriceAsc}</option>
      <option value="price_desc">{sortPriceDesc}</option>
    </select>
  </div>

  <div class="flex flex-col gap-1 min-w-[140px]">
    <label class="text-xs font-medium text-stone-500 uppercase tracking-wider">{neighborhoodLabel}</label>
    <select name="neighborhood" class="text-sm border border-stone-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent">
      <option value="">{allNeighborhoods}</option>
      {neighborhoods.map(n => (
        <option value={n}>{n}</option>
      ))}
    </select>
  </div>

  <div class="flex flex-col gap-1 min-w-[100px]">
    <label class="text-xs font-medium text-stone-500 uppercase tracking-wider">{priceLabel}</label>
    <select name="price" class="text-sm border border-stone-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent">
      <option value="">{anyOption}</option>
      <option value="€">€</option>
      <option value="€€">€€</option>
      <option value="€€€">€€€</option>
    </select>
  </div>

  {!isNails && (
    <div class="flex flex-col gap-1 min-w-[150px]">
      <label class="text-xs font-medium text-stone-500 uppercase tracking-wider">{massageTypeLabel}</label>
      <select name="massageType" class="text-sm border border-stone-200 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent">
        <option value="">{allOption}</option>
        {massageTypes.map(t => (
          <option value={t.id}>{massageTypeLabelFor(t)}</option>
        ))}
      </select>
    </div>
  )}
</form>
