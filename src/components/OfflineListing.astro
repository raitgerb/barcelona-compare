---
interface Props {
  lang?: 'es' | 'en' | 'ca';
}

const { lang = 'es' } = Astro.props;
const copy = {
  es: { label: '404', title: 'Ficha no disponible', body: 'Esta ficha ya no está publicada.', home: 'Volver al inicio' },
  en: { label: '404', title: 'Listing unavailable', body: 'This listing is no longer published.', home: 'Back to home' },
  ca: { label: '404', title: 'Fitxa no disponible', body: 'Aquesta fitxa ja no està publicada.', home: 'Tornar a l’inici' },
}[lang];
---

<div class="max-w-2xl mx-auto px-4 py-20 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">{copy.label}</p>
  <h1 class="mt-3 text-3xl font-bold text-stone-900">{copy.title}</h1>
  <p class="mt-4 text-stone-600">{copy.body}</p>
  <a href={lang === 'es' ? '/' : `/${lang}/`} class="mt-8 inline-flex rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-800">
    {copy.home}
  </a>
</div>
