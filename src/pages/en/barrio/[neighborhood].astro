---
// /en/barrio/{neighborhood}/ — English mirror of the ES barrio guide.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PaginatedListing from '../../../components/PaginatedListing.astro';
import { getCollection } from 'astro:content';
import { neighborhoodGuides } from '../../../data/neighborhoods';
import { SERVICES, MIN_CITY, MIN_COMBO } from '../../../lib/services';

export async function getStaticPaths() {
  return Object.keys(neighborhoodGuides).map(nb => ({
    params: { neighborhood: nb.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-') }
  }));
}

const { neighborhood } = Astro.params;
const guide = Object.entries(neighborhoodGuides).find(([nb]) =>
  nb.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-') === neighborhood
);
if (!guide) return Astro.redirect('/en/barrio/');
const [nbName, meta] = guide;

const nails = (await getCollection('nails'))
  .filter(b => b.data.neighborhood === nbName)
  .sort((a, b) => ((b.data.googleRating || 0) - (a.data.googleRating || 0)) || ((b.data.googleReviewCount || 0) - (a.data.googleReviewCount || 0)));
const massage = (await getCollection('massage'))
  .filter(b => b.data.neighborhood === nbName)
  .sort((a, b) => ((b.data.googleRating || 0) - (a.data.googleRating || 0)) || ((b.data.googleReviewCount || 0) - (a.data.googleReviewCount || 0)));

const avgRating = (list: any[]) => {
  const rated = list.filter(b => b.data.googleRating);
  if (!rated.length) return null;
  return (rated.reduce((s, b) => s + b.data.googleRating, 0) / rated.length).toFixed(1);
};
const nAvg = avgRating(nails);

// OSM embed: hand-tuned center per barrio (same as ES guide).
const centers: Record<string, [number, number]> = {
  'Eixample': [41.3925, 2.1650], 'Gràcia': [41.4022, 2.1568],
  'Ciutat Vella': [41.3833, 2.1769], 'Sarrià-Sant Gervasi': [41.4009, 2.1282],
  'Sants-Montjuïc': [41.3767, 2.1495], 'Sant Martí': [41.4100, 2.1990],
  'Les Corts': [41.3881, 2.1274], 'Horta-Guinardó': [41.4194, 2.1622],
  'Nou Barris': [41.4292, 2.1775], 'Sant Andreu': [41.4403, 2.1873],
};
const c = centers[nbName] || [41.39, 2.17];
const d = 0.008;
const bbox = `${(c[1] - d).toFixed(4)}%2C${(c[0] - d * 0.6).toFixed(4)}%2C${(c[1] + d).toFixed(4)}%2C${(c[0] + d * 0.6).toFixed(4)}`;
const osmSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${c[0]}%2C${c[1]}`;

const nbSlug = neighborhood;

// Money-page cross-links: district (≥MIN_CITY) + combo (≥MIN_COMBO), EN side.
const moneyLinks: Array<{ href: string; label: string }> = [];
{
  const allBiz = [...(await getCollection('nails')), ...(await getCollection('massage'))]
    .filter(b => b.data.neighborhood === nbName);
  for (const cat of ['nails', 'massage'] as const) {
    const catN = allBiz.filter(b => b.collection === cat).length;
    if (catN >= MIN_CITY) {
      moneyLinks.push({ href: `/en/mejores/${cat}/${nbSlug}/`, label: `Best ${cat === 'nails' ? 'nail salons' : 'massage centers'} in ${nbName}` });
    }
    const tagCounts = new Map<string, number>();
    for (const b of allBiz) {
      if (b.collection !== cat) continue;
      for (const t of ((b.data.serviceTags ?? []) as string[])) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
    }
    for (const svc of SERVICES[cat]) {
      const n = tagCounts.get(svc.slug) ?? 0;
      if (n >= MIN_COMBO) {
        moneyLinks.push({ href: `/en/mejores/${cat}/${nbSlug}/${svc.slug}/`, label: `${svc.en.keyword.charAt(0).toUpperCase()}${svc.en.keyword.slice(1)} in ${nbName} (${n})` });
      }
    }
  }
}

// ItemList schema: top businesses in this barrio
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Best businesses in ${nbName}`,
  numberOfItems: nails.length + massage.length,
  itemListElement: [...nails.slice(0, 10), ...massage.slice(0, 10)].map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.data.name,
    url: new URL(`/${b.collection}/${b.id}/`, Astro.site).href,
  })),
};
---

<BaseLayout
  title={`Nail salons & massage centers in ${nbName} — Guides`}
  description={`${nails.length + massage.length} businesses in ${nbName}: ${nails.length} nail salons and ${massage.length} massage centers. Ratings, hours and languages for each.`}
  lang="en"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <main class="max-w-6xl mx-auto px-4 py-12">
    <nav class="text-sm text-stone-500 mb-6" aria-label="breadcrumb">
      <a href="/en" class="hover:text-stone-700">Home</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <a href="/en/barrio/" class="hover:text-stone-700">Neighborhoods</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <span class="text-stone-700 font-medium">{nbName}</span>
    </nav>

    <header class="max-w-3xl">
      <h1 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight">{nbName}</h1>
      <p class="mt-4 text-stone-600 leading-relaxed">{meta.en}</p>
      <div class="flex flex-wrap gap-6 mt-6 text-sm">
        <div><span class="block text-2xl font-bold text-stone-900">{nails.length + massage.length}</span><span class="text-stone-500">businesses</span></div>
        <div><span class="block text-2xl font-bold text-stone-900">{(nails.reduce((s,b)=>s+(b.data.googleReviewCount||0),0)+massage.reduce((s,b)=>s+(b.data.googleReviewCount||0),0)).toLocaleString('en-US')}</span><span class="text-stone-500">Google reviews</span></div>
        {nAvg && <div><span class="block text-2xl font-bold text-stone-900">{nAvg}★</span><span class="text-stone-500">average rating</span></div>}
      </div>
    </header>

    <section class="mt-10 rounded-xl border border-stone-200 overflow-hidden bg-white">
      <iframe
        title={`Map of ${nbName}`}
        width="100%"
        height="280"
        style="border:0"
        loading="lazy"
        src={osmSrc}
      ></iframe>
    </section>

    {nails.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-bold text-stone-900">Nail salons in {nbName}</h2>
        <p class="text-stone-500 mt-1 text-sm">{nails.length} salons</p>
        <PaginatedListing businesses={nails.slice(0, 12)} category="nails" lang="en" total={nails.length} currentPage={1} totalPages={1} />
        <a href="/en/nails" class="inline-block mt-6 text-sm font-medium text-accent-nails hover:underline">See all nail salons →</a>
      </section>
    )}

    {massage.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-bold text-stone-900">Massage centers in {nbName}</h2>
        <p class="text-stone-500 mt-1 text-sm">{massage.length} centers</p>
        <PaginatedListing businesses={massage.slice(0, 12)} category="massage" lang="en" total={massage.length} currentPage={1} totalPages={1} />
        <a href="/en/massage" class="inline-block mt-6 text-sm font-medium text-accent-massage hover:underline">See all massage centers →</a>
      </section>
    )}

    {moneyLinks.length > 0 && (
      <section class="mt-14">
        <h2 class="text-xl font-bold text-stone-900">{nbName} comparisons</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {moneyLinks.map(l => (
            <a href={l.href} class="text-sm px-4 py-2 rounded-full border border-stone-200 hover:border-brand-400 hover:text-brand-600 transition-colors text-stone-700">{l.label}</a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
