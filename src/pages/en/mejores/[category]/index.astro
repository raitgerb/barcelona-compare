---
// /en/mejores/{category}/ — English hub listing districts + services.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SERVICES, slugify, MIN_CITY } from '../../../../lib/services';

export async function getStaticPaths() {
  return [
    { params: { category: 'nails' } },
    { params: { category: 'massage' } },
  ];
}

const { category } = Astro.params;
const cat = category as 'nails' | 'massage';

const CAT_META = {
  nails: { label: 'nail salons', short: 'Nails' },
  massage: { label: 'massage centers', short: 'Massage' },
};
const meta = CAT_META[cat];

const all = await getCollection(cat);
const nbCounts = new Map<string, number>();
for (const b of all) {
  const nb = b.data.neighborhood;
  if (nb && nb !== 'Barcelona') nbCounts.set(nb, (nbCounts.get(nb) ?? 0) + 1);
}
const districts = [...nbCounts.entries()]
  .map(([name, n]) => ({ name, slug: slugify(name), n }))
  .filter(e => e.n >= MIN_CITY)
  .sort((a, b) => b.n - a.n);

const tagCounts = SERVICES[cat].map(svc => ({
  ...svc,
  n: all.filter(b => ((b.data.serviceTags ?? []) as string[]).includes(svc.slug)).length,
})).filter(s => s.n >= MIN_CITY).sort((a, b) => b.n - a.n);
---

<BaseLayout
  title={`Best ${meta.label} in Barcelona — guides by neighborhood & service`}
  description={`Comparisons of ${meta.plural ?? meta.label} across Barcelona's districts and by service: ${tagCounts.slice(0, 5).map(s => s.en.keyword).join(', ')}. Ranked by real Google reviews.`}
  lang="en"
>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-stone-500 mb-6" aria-label="breadcrumb">
      <a href="/en" class="hover:text-stone-700">Home</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <span class="text-stone-700 font-medium">{meta.short}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight">Best {meta.label} in Barcelona</h1>
    <p class="mt-3 text-stone-600">Pick your district or the service you're after. Every guide ranks venues by real Google ratings.</p>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-stone-900 mb-4">By neighborhood</h2>
      <div class="flex flex-wrap gap-2">
        {districts.map(d => (
          <a href={`/en/mejores/${cat}/${d.slug}/`} class="text-sm px-4 py-2 rounded-full border border-stone-200 hover:border-brand-400 hover:text-brand-600 transition-colors text-stone-700">
            {d.name} <span class="text-stone-400">{d.n}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-stone-900 mb-4">By service</h2>
      <div class="flex flex-wrap gap-2">
        {tagCounts.map(s => (
          <a href={`/en/mejores/${cat}/${s.slug}/`} class="text-sm px-4 py-2 rounded-full border border-stone-200 hover:border-brand-400 hover:text-brand-600 transition-colors text-stone-700">
            {s.en.keyword} <span class="text-stone-400">{s.n}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-10 text-sm">
      <a href="/en/compare/" class="text-brand-600 hover:underline font-medium">Compare them side by side →</a>
    </p>
  </main>
</BaseLayout>
