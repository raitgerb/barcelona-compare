---
import BaseLayout from '../../layouts/BaseLayout.astro';
import manifest from '../../data/photo-manifest.json';

// Mirror of the ES compare page — hand the tray the lead photo index so its
// thumbnails match the photo the site leads with elsewhere (see
// scripts/score-photos.py).
const leads: Record<string, string> = {};
for (const [key, files] of Object.entries(manifest as Record<string, string[]>)) {
  if (Array.isArray(files) && files.length) leads[key] = String(files[0]);
}
---
<BaseLayout
  title="Compare businesses side by side"
  description="Compare nail salons and massage centers in Barcelona: Google ratings, reviews, opening hours, languages and services, side by side."
  lang="en"
>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone-900">Compare</h1>
    <p class="text-stone-500 mt-2">Pick 2–4 businesses from the lists and they show up here, side by side.</p>

    <!-- populated by /js/compare.js -->
    <div id="compare-root" class="mt-8"></div>
  </main>
  <script is:inline set:html={`window.BC_PHOTO_LEAD=${JSON.stringify(leads)};`}></script>
  <script src="/js/compare.js" defer></script>
</BaseLayout>
