---
import BaseLayout from '../../layouts/BaseLayout.astro';

// --- Claim CTA ---------------------------------------------------------------
// The Phase 0 claim flow is live: `/en/claim-business/` walks the owner through a
// 6-digit email code and writes the claimed+verified flags to the registry
// (docs/claim-flow.md). The mailto stays as the fallback for owners who would
// rather do it over email.
const CLAIM_EMAIL = 'hola@barcelonacompare.com';
const CLAIM_HREF = '/en/claim-business';
const claimSubject = 'I want to claim my business on Barcelona Compare';
const claimBody = [
  'Hi,',
  '',
  'I want to claim my business on Barcelona Compare.',
  '',
  'Business name:',
  'Category (nails / massage):',
  'Address:',
  'Phone:',
  'Website:',
  '',
  'Thanks.',
].join('\n');
const claimMailto = `mailto:${CLAIM_EMAIL}?subject=${encodeURIComponent(claimSubject)}&body=${encodeURIComponent(claimBody)}`;

// Real numbers, computed from the content collections at content-editing time
// (646 nails + 536 massage = 1,182 listings, 154,793 Google reviews).
const STATS = { businesses: '1,182', reviews: '154,793', districts: 10, avg: '4.7' };

const exampleHref = '/en/massage/abby-masaje-spa/';

const valuePoints = [
  {
    title: 'You show up where people already search',
    body: 'Your listing appears in the nail and massage lists, in all 10 district guides and in the “best of” pages, ordered by what your customers actually rated you on Google.',
  },
  {
    title: 'Correct details, not whatever Google still has',
    body: 'Many listings show the opening hours, phone or website Google Maps has kept for years. If something has changed, tell us and we fix it.',
  },
  {
    title: 'Direct contact, no commissions',
    body: 'Phone, website and WhatsApp. We do not handle bookings and we take no cut per customer: whoever writes to you, writes to you.',
  },
  {
    title: 'Local customers and visitors',
    body: 'The whole site is in Spanish and English, with services and reviews in both languages. You reach the neighbour in Gràcia and the visitor searching in Poblenou.',
  },
];

const faqs = [
  {
    q: 'How do I claim my business?',
    a: `Find your business in the directory, hit “Claim this business” and verify your email with a 6-digit code: the listing is marked as claimed and verified straight away. If you prefer, email us at ${CLAIM_EMAIL} and we will do it for you.`,
  },
  {
    q: 'Can I change my prices, services or opening hours?',
    a: 'Yes. Send us the list and we publish it. Today most listings show no prices at all: if you send yours, they will appear on your listing. Once your profile is claimed you will be able to edit them yourself.',
  },
  {
    q: 'Do you take a commission on bookings from the site?',
    a: 'There are no bookings to take a commission on: we do not manage appointments and charge nothing per customer. Clients call you, message you on WhatsApp or go straight to your website.',
  },
  {
    q: 'My business is not in the directory. What now?',
    a: 'Email us the name and address. We cover 1,182 Barcelona businesses: if yours is a nail salon or a massage centre and is missing, we add it for free.',
  },
  {
    q: 'Can I ask you to remove my business?',
    a: 'Yes. Email us and we take it out of the directory within 2-3 business days. You do not have to give a reason.',
  },
  {
    q: 'Where do the ratings and reviews come from?',
    a: 'From Google Maps, and they always appear attributed to Google. We do not publish our own reviews and we cannot edit or delete the ones you already have on Google.',
  },

  {
    q: 'Something on my listing is wrong.',
    a: 'We build listings from public Google Maps data. If you spot a mistake, tell us and we fix it; once the profile is claimed you will be able to edit it yourself.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};


---

<BaseLayout
  title="For businesses"
  description={`Claim your free listing on Barcelona Compare: fix your details, add services and prices, and reach the people searching for nail salons and massage centres in Barcelona. ${STATS.businesses} businesses listed.`}
  lang="en"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-stone-500 mb-6" aria-label="breadcrumb">
      <a href="/en" class="hover:text-stone-700">Home</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <span class="text-stone-700 font-medium">For businesses</span>
    </nav>

    <header>
      <h1 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight">
        Put your salon or centre in front of the people looking for it
      </h1>
      <p class="mt-4 text-lg text-stone-600 leading-relaxed">
        Barcelona Compare brings together <strong>{STATS.businesses} nail salons and massage centres</strong> in the city.
        Claim your listing for free, fix what Google has wrong and appear the way you want customers to see you.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={CLAIM_HREF}
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-brand-600 text-white font-semibold hover:bg-brand-700 transition-colors"
        >
          Claim my business for free
        </a>
        <a
          href={exampleHref}
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-stone-300 text-stone-700 font-medium hover:border-stone-400 hover:text-stone-900 transition-colors"
        >
          See an example listing →
        </a>
      </div>
      <p class="mt-3 text-sm text-stone-500">
        Or email us directly at <strong class="text-stone-700">{CLAIM_EMAIL}</strong> · reply within 2-3 business days
      </p>

      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 p-5 rounded-xl bg-white border border-stone-200">
        <div>
          <dt class="text-xs text-stone-500">Businesses listed</dt>
          <dd class="text-2xl font-bold text-stone-900">{STATS.businesses}</dd>
        </div>
        <div>
          <dt class="text-xs text-stone-500">Google reviews</dt>
          <dd class="text-2xl font-bold text-stone-900">{STATS.reviews}</dd>
        </div>
        <div>
          <dt class="text-xs text-stone-500">Districts covered</dt>
          <dd class="text-2xl font-bold text-stone-900">{STATS.districts}</dd>
        </div>
        <div>
          <dt class="text-xs text-stone-500">Average rating</dt>
          <dd class="text-2xl font-bold text-stone-900">{STATS.avg}★</dd>
        </div>
      </dl>
    </header>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-stone-900">What claiming your listing gets you</h2>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {valuePoints.map(p => (
          <div class="p-5 rounded-xl bg-white border border-stone-200">
            <h3 class="font-semibold text-stone-900">{p.title}</h3>
            <p class="mt-2 text-sm text-stone-600 leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-stone-900">How it works</h2>
      <ol class="mt-6 space-y-4">
        <li class="flex gap-4 p-5 rounded-xl bg-white border border-stone-200">
          <span class="shrink-0 w-7 h-7 rounded-full bg-brand-100 text-brand-700 font-bold text-sm flex items-center justify-center">1</span>
          <div>
            <h3 class="font-semibold text-stone-900">Find your business in the directory</h3>
            <p class="mt-1 text-sm text-stone-600">Search your name or street in the <a href="/en/nails" class="text-brand-600 hover:underline">nail</a> and <a href="/en/massage" class="text-brand-600 hover:underline">massage</a> lists. If you are not there, tell us and we add you for free.</p>
          </div>
        </li>
        <li class="flex gap-4 p-5 rounded-xl bg-white border border-stone-200">
          <span class="shrink-0 w-7 h-7 rounded-full bg-brand-100 text-brand-700 font-bold text-sm flex items-center justify-center">2</span>
          <div>
            <h3 class="font-semibold text-stone-900">Verify your email</h3>
            <p class="mt-1 text-sm text-stone-600">Hit “Claim this business” on your listing and we email you a 6-digit code. That is how we confirm you are the owner or the person responsible before we touch anything.</p>
          </div>
        </li>
        <li class="flex gap-4 p-5 rounded-xl bg-white border border-stone-200">
          <span class="shrink-0 w-7 h-7 rounded-full bg-brand-100 text-brand-700 font-bold text-sm flex items-center justify-center">3</span>
          <div>
            <h3 class="font-semibold text-stone-900">Your listing is marked as verified</h3>
            <p class="mt-1 text-sm text-stone-600">It shows the verified business badge and we publish any detail changes you send us within 2-3 business days. No fees, no contracts and no exclusivity: every business keeps being compared on the same terms.</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-stone-900">What your listing includes</h2>
      <p class="mt-2 text-stone-600">Your presence on Barcelona Compare is free. When you claim it, we verify that you run the business and give you control over the information customers see.</p>
      <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <li class="p-5 rounded-xl bg-white border border-stone-200"><strong class="text-stone-900">Public listing</strong><p class="mt-2 text-sm text-stone-600">Name, address, opening hours, phone, website, photos, Google rating and reviews.</p></li>
        <li class="p-5 rounded-xl bg-white border border-stone-200"><strong class="text-stone-900">Business verification</strong><p class="mt-2 text-sm text-stone-600">After you confirm your email, your listing shows the verified business badge.</p></li>
        <li class="p-5 rounded-xl bg-white border border-stone-200"><strong class="text-stone-900">Direct editing</strong><p class="mt-2 text-sm text-stone-600">Your dashboard lets you update services, prices, opening hours, photos and WhatsApp. Changes go live immediately.</p></li>
        <li class="p-5 rounded-xl bg-white border border-stone-200"><strong class="text-stone-900">Direct contact</strong><p class="mt-2 text-sm text-stone-600">People who find you can call, visit your website or message you on WhatsApp directly.</p></li>
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-stone-900">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
        {faqs.map(f => (
          <details class="group p-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer font-semibold text-stone-900 list-none">
              <span>{f.q}</span>
              <span class="shrink-0 text-stone-400 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm text-stone-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-14 p-8 rounded-2xl bg-brand-50 border border-brand-100 text-center">
      <h2 class="text-2xl font-bold text-stone-900">Claim your listing for free</h2>
      <p class="mt-2 text-stone-600 max-w-xl mx-auto">
        Find your business, verify your email with a 6-digit code and the listing is claimed and verified straight away.
      </p>
      <a
        href={CLAIM_HREF}
        class="inline-flex items-center gap-2 mt-5 px-6 py-3 rounded-lg bg-brand-600 text-white font-semibold hover:bg-brand-700 transition-colors"
      >
        Claim my business
      </a>
      <p class="mt-4 text-sm text-stone-600">
        Or email us at <a href={claimMailto} class="font-semibold text-brand-700 hover:underline">{CLAIM_EMAIL}</a>
      </p>
      <p class="mt-4 text-xs text-stone-500">
        Barcelona Compare is an independent aggregator and is not affiliated with Google. Ratings come from Google Maps.
        Want to know how we handle the data? <a href="/en/about" class="underline">How the site works</a>.
      </p>
    </section>
  </div>
</BaseLayout>
