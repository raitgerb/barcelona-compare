---
// Programmatic "best of" landing pages: /mejores/{category}/{neighborhood}/
// Auto-generated from content data — rankings by Bayesian rating, real review counts.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListingCard from '../../../components/ListingCard.astro';
import { getCollection } from 'astro:content';

const CATEGORIES = [
  { key: 'nails', label: 'salones de uñas', labelEn: 'nail salons', accent: 'accent-nails' },
  { key: 'massage', label: 'centros de masaje', labelEn: 'massage centers', accent: 'accent-massage' },
];

export async function getStaticPaths() {
  const categories = [
    { key: 'nails' as const },
    { key: 'massage' as const },
  ];
  const paths: Array<{ params: { category: string; neighborhood: string } }> = [];
  for (const cat of categories) {
    const all = await getCollection(cat.key);
    const barrios = [...new Set(all.map(b => b.data.neighborhood))]
      .filter(nb => nb && nb !== 'Barcelona')
      .map(nb => ({
        nb,
        slug: nb.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-'),
        count: all.filter(b => b.data.neighborhood === nb).length,
      }))
      .filter(e => e.count >= 15); // only build pages with enough depth to rank
    for (const e of barrios) {
      paths.push({ params: { category: cat.key, neighborhood: e.slug } });
    }
  }
  return paths;
}

const { category, neighborhood: slug } = Astro.params;

const CAT_META: Record<string, { label: string; plural: string; accent: string }> = {
  nails: { label: 'Salones de uñas', plural: 'salones', accent: 'text-accent-nails' },
  massage: { label: 'Centros de masaje', plural: 'centros', accent: 'text-accent-massage' },
};
const meta = CAT_META[category!];

const all = await getCollection(category as 'nails' | 'massage');
const guide = Object.entries(
  Object.fromEntries([...new Set(all.map(b => b.data.neighborhood))].map(nb => [
    nb.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-'), nb,
  ]))
);
const nbName = guide.find(([s]) => s === slug)?.[1] ?? slug;
if (!nbName) return Astro.redirect('/');

// Bayesian ranking: rating weighted toward the global mean when review count is low
const rated = all.filter(b => b.data.googleRating);
const globalMean = rated.reduce((s, b) => s + (b.data.googleRating || 0), 0) / (rated.length || 1);
const PRIOR_M = 50; // pseudo-review weight
const ranked = all
  .filter(b => b.data.neighborhood === nbName)
  .sort((a, b) => {
    const wa = ((a.data.googleRating || globalMean) * (a.data.googleReviewCount || 0) + globalMean * PRIOR_M)
             / ((a.data.googleReviewCount || 0) + PRIOR_M);
    const wb = ((b.data.googleRating || globalMean) * (b.data.googleReviewCount || 0) + globalMean * PRIOR_M)
             / ((b.data.googleReviewCount || 0) + PRIOR_M);
    return wb - wa;
  });

const top = ranked.slice(0, 20);
const totalReviews = ranked.reduce((s, b) => s + (b.data.googleReviewCount || 0), 0);
const withRating = ranked.filter(b => b.data.googleRating);
const avg = withRating.length ? (withRating.reduce((s, b) => s + (b.data.googleRating || 0), 0) / withRating.length).toFixed(1) : null;
const langCounts: Record<string, number> = {};
for (const b of ranked) {
  for (const l of (b.data.languages || []) as string[]) langCounts[l] = (langCounts[l] || 0) + 1;
}
const topLangs = Object.entries(langCounts).sort((a, b) => b[1] - a[1]).slice(0, 4);

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Mejores ${meta.label} en ${nbName}`,
  numberOfItems: top.length,
  itemListElement: top.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.data.name,
    url: new URL(`/${category}/${b.id}/`, Astro.site).href,
  })),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `¿Cuáles son los mejores ${meta.plural} en ${nbName}?`,
      acceptedAnswer: { '@type': 'Answer', text: `Según las valoraciones de Google, los mejores incluyen ${top.slice(0, 3).map(b => b.data.name).join(', ')}. Compara todos los ${meta.plural} de ${nbName} con precios, horarios e idiomas en esta guía.` },
    },
    {
      '@type': 'Question',
      name: `¿Cuántos ${meta.plural} hay en ${nbName}?`,
      acceptedAnswer: { '@type': 'Answer', text: `En ${nbName} hay ${ranked.length} ${meta.plural} con una valoración media de ${avg} sobre 5, basada en más de ${Math.round(totalReviews / 100) * 100} reseñas de Google.` },
    },
  ],
};
---

<BaseLayout
  title={`Los ${top.length > 0 ? '' : ''}mejores ${meta.label.toLowerCase()} en ${nbName} (2026)`}
  description={`${ranked.length} ${meta.plural} en ${nbName} comparados por valoración, reseñas e idiomas. Media de ${avg}★ sobre ${totalReviews.toLocaleString('es-ES')} reseñas de Google. Ranking actualizado.`}
  lang="es"
>
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-stone-500 mb-6" aria-label="breadcrumb">
      <a href="/" class="hover:text-stone-700">Inicio</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <a href="/barrio/" class="hover:text-stone-700">Barrios</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <span class="text-stone-700 font-medium">Mejores {meta.plural} · {nbName}</span>
    </nav>

    <header>
      <h1 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight">Los mejores {meta.label.toLowerCase()} en {nbName}</h1>
      <p class="mt-4 text-stone-600 leading-relaxed">
        Hemos comparado los <strong>{ranked.length} {meta.plural}</strong> de {nbName}
        según sus valoraciones reales de Google{avg ? `, con una nota media de <strong>${avg}★</strong>` : ''}
        y más de <strong>{totalReviews.toLocaleString('es-ES')} reseñas</strong>.
        El ranking pondera la nota y el número de reseñas para que no gane un 5★ con solo tres opiniones.
        {topLangs.length > 0 && `Idiomas más comunes: ${topLangs.map(([l]) => l.toLowerCase()).join(', ')}.`}
      </p>
      <div class="flex flex-wrap gap-6 mt-6 text-sm">
        <div><span class="block text-2xl font-bold text-stone-900">{ranked.length}</span><span class="text-stone-500">{meta.plural}</span></div>
        {avg && <div><span class="block text-2xl font-bold text-stone-900">{avg}★</span><span class="text-stone-500">valoración media</span></div>}
        <div><span class="block text-2xl font-bold text-stone-900">{totalReviews.toLocaleString('es-ES')}</span><span class="text-stone-500">reseñas analizadas</span></div>
      </div>
    </header>

    <section class="mt-10 space-y-3">
      {top.map((b, i) => (
        <div class="flex items-start gap-4 bg-white rounded-xl border border-stone-200 p-4 hover:border-stone-300 hover:shadow-sm transition-all">
          <span class={`text-xl font-bold w-8 shrink-0 text-center ${i < 3 ? 'text-brand-600' : 'text-stone-300'}`}>{i + 1}</span>
          <div class="min-w-0 flex-1">
            <ListingCard
              name={b.data.name}
              neighborhood={b.data.neighborhood}
              googleRating={b.data.googleRating}
              googleReviewCount={b.data.googleReviewCount}
              priceIndicator={b.data.priceIndicator}
              slug={b.id}
              category={category as 'nails' | 'massage'}
              lang="es"
            />
          </div>
        </div>
      ))}
    </section>

    <section class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-8 text-sm text-stone-600">
      <div>
        <h2 class="font-bold text-stone-900 mb-2">¿Cómo hacemos el ranking?</h2>
        <p>Usamos la valoración de Google ponderada por el número de reseñas (media bayesiana): un local con 4.9★ y 800 opiniones puntúa más que uno con 5★ y 5 opiniones. Los datos se actualizan periódicamente desde Google Maps.</p>
      </div>
      <div>
        <h2 class="font-bold text-stone-900 mb-2">Explora {nbName}</h2>
        <p>¿Prefieres verlo en el mapa o filtrar por abierto ahora? Consulta la <a href={`/barrio/${slug}/`} class="text-brand-600 hover:underline font-medium">guía completa de {nbName}</a> o compara lado a lado desde cualquier lista.</p>
      </div>
    </section>
  </main>
</BaseLayout>
