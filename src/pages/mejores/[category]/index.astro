---
// /mejores/{category}/ — hub listing districts + services for one category.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SERVICES, slugify, MIN_CITY } from '../../../lib/services';

export async function getStaticPaths() {
  return [
    { params: { category: 'nails' } },
    { params: { category: 'massage' } },
  ];
}

const { category } = Astro.params;
const cat = category as 'nails' | 'massage';

const CAT_META = {
  nails: { label: 'salones de uñas', plural: 'salones', short: 'Uñas' },
  massage: { label: 'centros de masaje', plural: 'centros de masaje', short: 'Masajes' },
};
const meta = CAT_META[cat];

const all = await getCollection(cat);
const nbCounts = new Map<string, number>();
for (const b of all) {
  const nb = b.data.neighborhood;
  if (nb && nb !== 'Barcelona') nbCounts.set(nb, (nbCounts.get(nb) ?? 0) + 1);
}
const districts = [...nbCounts.entries()]
  .map(([name, n]) => ({ name, slug: slugify(name), n }))
  .filter(e => e.n >= MIN_CITY)
  .sort((a, b) => b.n - a.n);

const tagCounts = SERVICES[cat].map(svc => ({
  ...svc,
  n: all.filter(b => ((b.data.serviceTags ?? []) as string[]).includes(svc.slug)).length,
})).filter(s => s.n >= MIN_CITY).sort((a, b) => b.n - a.n);
---

<BaseLayout
  title={`Los mejores ${meta.label} en Barcelona — guías por distrito y servicio`}
  description={`Comparativas de ${meta.plural} en Barcelona por distrito (${districts.map(d => d.name).slice(0, 4).join(', ')}…) y por servicio: ${tagCounts.slice(0, 5).map(s => s.es.keyword).join(', ')}.`}
  lang="es"
>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-stone-500 mb-6" aria-label="breadcrumb">
      <a href="/" class="hover:text-stone-700">Inicio</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <span class="text-stone-700 font-medium">{meta.short}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight">Los mejores {meta.label} en Barcelona</h1>
    <p class="mt-3 text-stone-600">Elige tu distrito o el servicio que buscas. Cada guía compara los centros por valoración real de Google.</p>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-stone-900 mb-4">Por distrito</h2>
      <div class="flex flex-wrap gap-2">
        {districts.map(d => (
          <a href={`/mejores/${cat}/${d.slug}/`} class="text-sm px-4 py-2 rounded-full border border-stone-200 hover:border-brand-400 hover:text-brand-600 transition-colors text-stone-700">
            {d.name} <span class="text-stone-400">{d.n}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-stone-900 mb-4">Por servicio</h2>
      <div class="flex flex-wrap gap-2">
        {tagCounts.map(s => (
          <a href={`/mejores/${cat}/${s.slug}/`} class="text-sm px-4 py-2 rounded-full border border-stone-200 hover:border-brand-400 hover:text-brand-600 transition-colors text-stone-700">
            {s.es.keyword} <span class="text-stone-400">{s.n}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
