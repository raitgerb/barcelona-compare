---
import BaseLayout from '../layouts/BaseLayout.astro';
import manifest from '../data/photo-manifest.json';

// The tray builds image URLs client-side, so hand it the lead photo index for
// every business (manifest order puts the best-scoring photo first — see
// scripts/score-photos.py). Without this the tray would fall back to file 0,
// which is not necessarily the photo the rest of the site leads with.
const leads: Record<string, string> = {};
for (const [key, files] of Object.entries(manifest as Record<string, string[]>)) {
  if (Array.isArray(files) && files.length) leads[key] = String(files[0]);
}
---
<BaseLayout
  title="Compara negocios lado a lado"
  description="Compara salones de manicura y centros de masaje en Barcelona: valoraciones, reseñas, horarios, idiomas y servicios, lado a lado."
  lang="es"
>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone-900">Comparar</h1>
    <p class="text-stone-500 mt-2">Elige 2–4 negocios en las listas y aparecen aquí, lado a lado.</p>

    <!-- populated by /js/compare.js -->
    <div id="compare-root" class="mt-8"></div>
  </main>
  <script is:inline set:html={`window.BC_PHOTO_LEAD=${JSON.stringify(leads)};`}></script>
  <script src="/js/compare.js" defer></script>
</BaseLayout>
