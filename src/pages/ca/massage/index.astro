---
// /ca/massage/ — Catalan listing index.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilterBar from '../../../components/FilterBar.astro';
import PaginatedListing from '../../../components/PaginatedListing.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 30;
const businesses = await getCollection('massage');
businesses.sort((a, b) => (b.data.googleRating || 0) - (a.data.googleRating || 0));
const totalPages = Math.ceil(businesses.length / PAGE_SIZE);
---

<BaseLayout
  title="Els millors centres de massatge de Barcelona"
  description={`Compara centres de massatge a Barcelona. Preus, tipus de massatge i valoracions de Google. ${businesses.length} centres.`}
  lang="ca"
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-stone-900">Massatges a Barcelona</h1>
      <p class="text-stone-500 mt-2">{businesses.length} centres — compara preus, tipus de massatge i valoracions{totalPages > 1 && <span> — pàgina 1 de {totalPages}</span>}</p>
    </div>
    <FilterBar category="massage" lang="ca" />
    <PaginatedListing businesses={businesses.slice(0, PAGE_SIZE)} category="massage" lang="ca" total={businesses.length} currentPage={1} totalPages={totalPages} />
  </section>
</BaseLayout>
