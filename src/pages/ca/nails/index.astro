---
// /ca/nails/ — Catalan listing index.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilterBar from '../../../components/FilterBar.astro';
import PaginatedListing from '../../../components/PaginatedListing.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 30;
const businesses = await getCollection('nails');
businesses.sort((a, b) => (b.data.googleRating || 0) - (a.data.googleRating || 0));
const totalPages = Math.ceil(businesses.length / PAGE_SIZE);
---

<BaseLayout
  title="Els millors salons de manicura de Barcelona"
  description={`Compara salons de manicura a Barcelona. Preus, tècniques i valoracions de Google. ${businesses.length} salons.`}
  lang="ca"
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-stone-900">Salons de manicura a Barcelona</h1>
      <p class="text-stone-500 mt-2">{businesses.length} salons — compara preus, tècniques i valoracions{totalPages > 1 && <span> — pàgina 1 de {totalPages}</span>}</p>
    </div>
    <FilterBar category="nails" lang="ca" />
    <PaginatedListing businesses={businesses.slice(0, PAGE_SIZE)} category="nails" lang="ca" total={businesses.length} currentPage={1} totalPages={totalPages} />
  </section>
</BaseLayout>
