---
// /ca/mejores/{category}/ — Catalan hub listing districts + services.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SERVICES, slugify, MIN_CITY } from '../../../../lib/services';

export async function getStaticPaths() {
  return [
    { params: { category: 'nails' } },
    { params: { category: 'massage' } },
  ];
}

const { category } = Astro.params;
const cat = category as 'nails' | 'massage';

const CAT_META = {
  nails: { label: 'salons de manicura', short: 'Ungles' },
  massage: { label: 'centres de massatge', short: 'Massatges' },
};
const meta = CAT_META[cat];

const all = await getCollection(cat);
const nbCounts = new Map<string, number>();
for (const b of all) {
  const nb = b.data.neighborhood;
  if (nb && nb !== 'Barcelona') nbCounts.set(nb, (nbCounts.get(nb) ?? 0) + 1);
}
const districts = [...nbCounts.entries()]
  .map(([name, n]) => ({ name, slug: slugify(name), n }))
  .filter(e => e.n >= MIN_CITY)
  .sort((a, b) => b.n - a.n);

const tagCounts = SERVICES[cat].map(svc => ({
  ...svc,
  n: all.filter(b => ((b.data.serviceTags ?? []) as string[]).includes(svc.slug)).length,
})).filter(s => s.n >= MIN_CITY).sort((a, b) => b.n - a.n);
---

<BaseLayout
  title={`Els millors ${meta.label} de Barcelona — guies per barri i servei`}
  description={`Comparatives dels ${meta.label} de Barcelona per districte i per servei: ${tagCounts.slice(0, 5).map(s => s.ca.keyword).join(', ')}. Ordenats per valoracions reals de Google.`}
  lang="ca"
>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-stone-500 mb-6" aria-label="breadcrumb">
      <a href="/ca" class="hover:text-stone-700">Inici</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <span class="text-stone-700 font-medium">{meta.short}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight">Els millors {meta.label} de Barcelona</h1>
    <p class="mt-3 text-stone-600">Tria el teu districte o el servei que busques. Cada guia ordena els negocis per valoracions reals de Google.</p>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-stone-900 mb-4">Per barri</h2>
      <div class="flex flex-wrap gap-2">
        {districts.map(d => (
          <a href={`/ca/mejores/${cat}/${d.slug}/`} class="text-sm px-4 py-2 rounded-full border border-stone-200 hover:border-brand-400 hover:text-brand-600 transition-colors text-stone-700">
            {d.name} <span class="text-stone-400">{d.n}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-stone-900 mb-4">Per servei</h2>
      <div class="flex flex-wrap gap-2">
        {tagCounts.map(s => (
          <a href={`/ca/mejores/${cat}/${s.slug}/`} class="text-sm px-4 py-2 rounded-full border border-stone-200 hover:border-brand-400 hover:text-brand-600 transition-colors text-stone-700">
            {s.ca.keyword} <span class="text-stone-400">{s.n}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-10 text-sm">
      <a href="/ca/compare/" class="text-brand-600 hover:underline font-medium">Compara'ls costat a costat →</a>
    </p>
  </main>
</BaseLayout>
