---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Lightbox from '../../../components/Lightbox.astro';
import DetailEnhancements from '../../../components/DetailEnhancements.astro';
import ReviewQuotes from '../../../components/ReviewQuotes.astro';
import ReviewInsights from '../../../components/ReviewInsights.astro';
import EventTracking from '../../../components/EventTracking.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
import ClaimCta from '../../../components/ClaimCta.astro';
import WhatsappCta from '../../../components/WhatsappCta.astro';
import { getCollection } from 'astro:content';
import { imagePath } from '../../../lib/images';
import { verifiedBusinessFor } from '../../../lib/registry';

export async function getStaticPaths() {
  const businesses = await getCollection('nails');
  return businesses.map(b => ({ params: { slug: b.id } }));
}

const { slug } = Astro.params;
const businesses = await getCollection('nails');
const business = businesses.find(b => b.id === slug);

if (!business) {
  return Astro.redirect('/nails');
}

const { data } = business;
const verified = await verifiedBusinessFor(data.googlePlaceId);
const stars = data.googleRating ? Math.round(data.googleRating) : 0;

const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
const dayLabels: Record<string, string> = {
  monday: 'Lunes', tuesday: 'Martes', wednesday: 'Miércoles', thursday: 'Jueves',
  friday: 'Viernes', saturday: 'Sábado', sunday: 'Domingo',
};

const galleryPath = imagePath('nails', slug);
const googleMapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY;
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  "name": data.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": data.address,
    "addressLocality": "Barcelona",
    "addressCountry": "ES"
  },
  "telephone": data.phone || undefined,
  "priceRange": data.priceIndicator || undefined,
  ...(data.googleRating && {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": data.googleRating,
      "reviewCount": data.googleReviewCount
    }
  }),
  ...(data.hours && {
    "openingHoursSpecification": Object.entries(data.hours as Record<string, string>).map(([day, time]) => {
      const [open, close] = time.split("-");
      return {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": `https://schema.org/${day.charAt(0).toUpperCase() + day.slice(1)}`,
        "opens": open,
        "closes": close
      };
    })
  })
};
---

<BaseLayout
  title={`${data.name} — Salón de manicura en ${data.neighborhood}`}
  description={`${data.name} en ${data.neighborhood}, Barcelona. ${data.googleRating ? `Valoración: ${data.googleRating}/5 (${data.googleReviewCount} reseñas).` : ''} Servicios: ${data.services.map(s => s.name).join(', ')}.`}
  image={`${galleryPath}-0.jpg`}
  lang="es"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)}></script>

  <article class="max-w-3xl mx-auto px-4 py-12">
    <div class="bg-white rounded-xl border border-stone-200 p-6 md:p-8">
      <!-- Photo Gallery -->
      {[0, 1, 2, 3, 4].some(i => true) && (
        <!--owner:gallery-->
        <div class="photo-gallery flex gap-3 mb-8 overflow-x-auto pb-2 snap-x snap-mandatory scrollbar-thin">
          {[0, 1, 2, 3, 4].map(i => {
            const src = `${galleryPath}-${i}.jpg`;
            return (
              <img
                src={src}
                alt={`${data.name} - foto ${i + 1}`}
                class="snap-start min-w-[280px] h-48 object-cover rounded-xl border border-stone-100 bg-stone-100"
                width="280"
                height="192"
                loading="lazy"
                decoding="async"
                onerror="this.style.visibility='hidden'"
              />
            );
          })}
        </div>
      )}

      <!--/owner:gallery-->
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl font-bold text-stone-900">{data.name}</h1>
          <p class="text-stone-500 mt-1">{data.address}, {data.neighborhood}</p>
          {data.priceIndicator && (
            <span class="inline-block mt-2 text-sm font-medium px-3 py-1 rounded-full bg-stone-100 text-stone-600" title="Nivel de precio orientativo según Google. El precio real puede variar — consulta la carta del negocio.">
              {data.priceIndicator} · orientativo
            </span>
          )}
          {verified ? (
            <div class="mt-2">
              <VerifiedBadge lang="es" variant="detail" tier={verified.tier} />
            </div>
          ) : (
            <ClaimCta lang="es" placeId={data.googlePlaceId} variant="inline" class="mt-2" />
          )}
        </div>
      </div>

      <!--owner:whatsapp-->
      <WhatsappCta whatsapp={data.whatsapp} lang="es" />
      <!--/owner:whatsapp-->

      <div class="flex flex-wrap gap-2 mb-8">
        {data.phone && (
          <a href={`tel:${data.phone}`} data-track-event="click_phone" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            {data.phone}
          </a>
        )}
        {data.website && (
          <a href={data.website} target="_blank" rel="noopener" data-track-event="click_website" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-stone-300 text-stone-700 text-sm font-medium hover:bg-stone-50 transition-colors">
            Web
          </a>
        )}
      </div>

      {data.googleRating && (
        <div class="mb-8 p-4 bg-stone-50 rounded-lg">
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-0.5">
              {[1, 2, 3, 4, 5].map(i => (
                <svg class={`w-5 h-5 ${i <= stars ? 'text-amber-400' : 'text-stone-200'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="text-lg font-bold text-stone-900">{data.googleRating}</span>
            <span class="text-sm text-stone-500">· {data.googleReviewCount} reseñas en Google</span>
          </div>
          <ReviewInsights lang="es" reviews={data.googleReviews || []} reviewCount={data.googleReviewCount} />
          <p class="text-xs text-stone-400 mt-2 flex items-center gap-1">
            <img src="https://www.gstatic.com/images/branding/googlelogo/svg/googlelogo_dark_clr_74x24px.svg" alt="Google" class="h-3 opacity-50" />
            Powered by Google
          </p>
        </div>
      )}

      <!--owner:services-->
      {data.services.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-stone-900 mb-3">Servicios y precios</h2>
          <div class="divide-y divide-stone-100">
            {data.services.map(service => (
              <div class="flex justify-between py-2.5">
                <span class="text-stone-700">{typeof service === 'string' ? service : service.name}</span>
                {typeof service !== 'string' && service.price && <span class="font-medium text-stone-900">{service.price}</span>}
              </div>
            ))}
          </div>
        </section>
      )}

      <!--/owner:services-->

      <!--owner:hours-->
      {data.hours && Object.keys(data.hours).length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-stone-900 mb-3">Horario</h2>
          <div class="divide-y divide-stone-100">
            {days.map(day => {
              const hours = data.hours?.[day];
              if (!hours) return null;
              return (
                <div class="flex justify-between py-2 text-sm">
                  <span class="text-stone-500 w-24">{dayLabels[day]}</span>
                  <span class="text-stone-700">{hours}</span>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!--/owner:hours-->

      {data.languages && data.languages.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-stone-900 mb-2">Idiomas</h2>
          <div class="flex flex-wrap gap-2">
            {data.languages.map((lang: string) => (
              <span class="text-sm px-3 py-1 rounded-full bg-stone-100 text-stone-600">{lang}</span>
            ))}
          </div>
        </section>
      )}

      {data.googlePlaceId && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-stone-900 mb-3">Ubicación</h2>
          <div class="rounded-lg overflow-hidden border border-stone-200">
            <iframe
              width="100%"
              height="300"
              style="border:0"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps/embed/v1/place?key=${googleMapsKey}&q=place_id:${data.googlePlaceId}`}
            >
            </iframe>
          </div>
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(data.address)}&destination_place_id=${data.googlePlaceId}`} target="_blank" rel="noopener" data-track-event="click_directions" class="mt-3 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-stone-300 text-stone-700 text-sm font-medium hover:bg-stone-50 transition-colors">
            Cómo llegar
          </a>
        </section>
      )}

      {verified ? (
        <div class="mt-8 p-4 bg-emerald-50 rounded-lg border border-emerald-100 text-center">
          <p class="text-sm font-medium text-emerald-700">Negocio verificado por su propietario</p>
          <p class="text-xs text-stone-500 mt-1">
            Los datos de esta ficha están gestionados por el negocio. <a href="/for-businesses" class="font-medium text-brand-600 hover:underline">Cómo funciona</a>
          </p>
        </div>
      ) : (
        <ClaimCta lang="es" placeId={data.googlePlaceId} name={data.name} variant="banner" class="mt-8" />
      )}
    </div>
    <ReviewQuotes name={data.name} googleRating={data.googleRating} googleReviewCount={data.googleReviewCount} reviews={data.googleReviews || []} />
    <DetailEnhancements category="nails" slug={slug} neighborhood={data.neighborhood} lang="es" />
    {data.googlePlaceId && <EventTracking placeId={data.googlePlaceId} />}
  </article>
  <Lightbox imagePath={galleryPath} photoCount={5} altText={data.name} />
</BaseLayout>
