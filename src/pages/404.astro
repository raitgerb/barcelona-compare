---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada — Barcelona Compare"
  description="La página que buscas no está disponible."
  lang="es"
>
  <main class="max-w-2xl mx-auto px-4 py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">404</p>
    <h1 class="mt-3 text-3xl font-bold text-stone-900">Página no encontrada</h1>
    <p class="mt-4 text-stone-600">Esta ficha o página ya no está publicada.</p>
    <a href="/" class="mt-8 inline-flex rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-800">
      Volver al inicio
    </a>
  </main>
</BaseLayout>
