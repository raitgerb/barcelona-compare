---
import '../styles/global.css';
import { ui } from '../i18n/ui';
import { DEFAULT_LOCALE, LOCALES, LOCALE_LABELS, localeHref, localePath, stripLocale, type Locale } from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: Locale;
  /** Locales this page is actually built in. Defaults to all three; the
   *  owner-facing app surfaces (claim flow, dashboard) are ES+EN only. */
  langs?: Locale[];
  /** Override the alternate path when the two locales do not share a path
   *  (e.g. /reclamar <-> /en/claim-business). Only used with a two-locale `langs`. */
  altPath?: string;
}

const { title, description, image, lang = DEFAULT_LOCALE, langs = [...LOCALES], altPath } = Astro.props;
const t = ui[lang];

const currentPath = Astro.url.pathname;
const bare = stripLocale(currentPath);

// --- hreflang -----------------------------------------------------------------
// One <link rel="alternate"> per locale the page is built in — including a
// self-referencing one for the current locale, which is what Google expects —
// plus x-default pointing at the ES version (the default locale). App surfaces
// keep the single altPath-based alternate they had before and declare no x-default.
const alternates = langs.map(l => ({
  lang: l,
  href: langs.length === 2 && altPath ? (l === lang ? currentPath : altPath) : localeHref(l, currentPath),
}));
const xDefault = langs.length === LOCALES.length ? localeHref(DEFAULT_LOCALE, currentPath) : null;

const navItems: Array<{ key: keyof typeof t; href: string }> = [
  { key: 'nav.home' as keyof typeof t, href: localePath(lang, '/') },
  { key: 'nav.nails' as keyof typeof t, href: localePath(lang, '/nails') },
  { key: 'nav.massage' as keyof typeof t, href: localePath(lang, '/massage') },
  { key: 'nav.barrios' as keyof typeof t, href: localePath(lang, '/barrio/') },
];

const tagline: Record<Locale, string> = {
  es: 'Encuentra · Compara · Elige',
  en: 'Find · Compare · Choose',
  ca: 'Troba · Compara · Tria',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Barcelona Compare</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Barcelona Compare`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(currentPath, Astro.site).href} />
    <meta property="og:image" content={image ? new URL(image, Astro.site).href : new URL('/og-default.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Barcelona Compare`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image ? new URL(image, Astro.site).href : new URL('/og-default.png', Astro.site).href} />
    {alternates.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, Astro.site).href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />}
    <link rel="canonical" href={new URL(currentPath, Astro.site).href} />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline defer type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ce7b3abd9d7f489ab3433b50cf598784"}'></script>

    <!-- Portfolio analytics: PostHog EU, consent-gated. Owner docs: docs/analytics.md
         The SDK is loaded un-gated (PostHog's own guidance) but capture is OFF until
         the visitor accepts; no event and no identity is stored before that. -->
    <script is:inline>
      window.PORTFOLIO_ANALYTICS = {
        projectToken: 'phc_sSGPRZfJzSLdSrsk8G6cTVptxdFbJi3WQ6td3zMUE55z',
        site: { key: 'barcelonacompare', label: 'barcelonacompare.com' },
        allowedHosts: ['barcelonacompare.com', 'www.barcelonacompare.com']
      };
    </script>
    <script is:inline defer src="/js/portfolio-analytics.js"></script>
    <script is:inline defer src="/js/portfolio-analytics-outbound.js"></script>



  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-stone-200 bg-white/80 backdrop-blur-sm sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href={localePath(lang, '/')} class="text-xl font-bold text-stone-900 tracking-tight">
          Barcelona <span class="text-brand-500">Compare</span>
        </a>
        <div class="flex items-center gap-6 text-sm font-medium">
          {navItems.map(item => (
            <a
              href={item.href}
              class="text-stone-600 hover:text-stone-900 transition-colors"
            >
              {t[item.key]}
            </a>
          ))}
          <span class="flex items-center gap-1" aria-label="Language">
            {langs.map(l => (
              l === lang ? (
                <span
                  class="text-xs px-3 py-1 rounded-full border border-stone-400 bg-stone-100 text-stone-700 font-semibold"
                  aria-current="true"
                >
                  {LOCALE_LABELS[l]}
                </span>
              ) : (
                <a
                  href={langs.length === 2 && altPath ? altPath : localePath(l, bare)}
                  hreflang={l}
                  class="text-xs px-3 py-1 rounded-full border border-stone-300 text-stone-500 hover:border-stone-400 hover:text-stone-700 transition-colors font-medium"
                >
                  {LOCALE_LABELS[l]}
                </a>
              )
            ))}
          </span>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-stone-200 bg-white mt-16">
      <div class="max-w-6xl mx-auto px-4 py-8 text-sm text-stone-500">
        <div class="flex flex-col sm:flex-row justify-between gap-4">
          <div>
            <p class="font-medium text-stone-700 mb-1">Barcelona Compare</p>
            <p class="text-xs text-stone-400">{tagline[lang]}</p>
          </div>
          <div class="flex gap-6">
            <a href={localePath(lang, '/about')} class="hover:text-stone-700 transition-colors">{t['nav.about']}</a>
            <a href={localePath(lang, '/for-businesses')} class="hover:text-stone-700 transition-colors">{t['nav.businesses']}</a>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex flex-col sm:flex-row justify-between gap-2 text-xs text-stone-400">
          <span>&copy; {new Date().getFullYear()} Barcelona Compare</span>
          <span class="flex items-center gap-1">
            <img src="https://www.gstatic.com/images/branding/googlelogo/svg/googlelogo_dark_clr_74x24px.svg" alt="Google" class="h-3.5 opacity-60" />
            <span>Powered by Google</span>
          </span>
        </div>
      </div>
    </footer>
  

  

  

  
    <!-- Consent banner + persistent withdrawal control (docs/analytics.md). -->
    <!--
      Reference consent banner (no analytics vendor, no framework, ~1.8 KB).
      Drop into each site once, after portfolio-analytics.js. It only talks to the loader:
      it never loads a third-party script itself.

      Accessibility commitments: real buttons, keyboard reachable, focus visible, role=dialog
      with an accessible name, and it does not trap focus (it sits at the end of the DOM).
      Reject is exactly as prominent and as easy as Accept — a one-click accept with a
      hidden reject fails the "freely given" test in the GDPR guidance PostHog links to.

      ORDERING HAZARD (cost a real test iteration): the loader is a DEFERRED script, so this
      inline block usually executes BEFORE the loader has booted. Deciding immediately would
      read `undefined` and wrongly show a banner. So every decision is made lazily - on the
      loader's own `portfolioanalytics:ready` announcement - and the markup starts `hidden`.
    -->
    <div id="pa-banner" hidden role="dialog" aria-modal="false" aria-labelledby="pa-banner-title"
         style="position:fixed;left:0;right:0;bottom:0;z-index:2147483000;background:#1c1917;color:#fafaf9;
                font:14px/1.5 system-ui,-apple-system,Segoe UI,sans-serif;padding:14px 16px;
                display:flex;gap:12px;align-items:center;flex-wrap:wrap;box-shadow:0 -2px 12px rgba(0,0,0,.25)">
      <p id="pa-banner-title" style="margin:0;flex:1 1 320px">
        We use one first-party analytics tool (PostHog, hosted in the EU) to understand which pages
        and tools are useful. It never sees your files, form contents or search terms, and session
        recording is off. You can change your mind at any time.
      </p>
      <button type="button" data-pa-consent="denied"
              style="padding:9px 16px;border:1px solid #78716c;background:transparent;color:inherit;
                     border-radius:6px;cursor:pointer;font:inherit">Reject analytics</button>
      <button type="button" data-pa-consent="granted"
              style="padding:9px 16px;border:0;background:#fafaf9;color:#1c1917;
                     border-radius:6px;cursor:pointer;font:inherit;font-weight:600">Accept analytics</button>
    </div>

    <!-- Persistent withdrawal control: put this (or an equivalent link) in the site footer. -->
    <button type="button" id="pa-withdraw" hidden
            style="background:none;border:0;padding:0;color:inherit;text-decoration:underline;cursor:pointer;font:inherit">
      Change analytics choice
    </button>

    <script is:inline>
    (function () {
      'use strict';
      var banner = document.getElementById('pa-banner');
      var withdraw = document.getElementById('pa-withdraw');
      if (!banner) return;
      var decided = false;

      function api() { return window.portfolioAnalytics; }

      function decide() {
        decided = true;
        var a = api();
        // No loader at all, or a host that is not on the site's allowlist (a preview
        // deployment, a dev server, an accidental embed): nothing can be collected,
        // so do not ask permission for something that will not happen.
        if (!a || a.enabled === false) {
          banner.hidden = true;
          withdraw.hidden = true;
          return;
        }
        if (a.getConsent() === null) {
          banner.hidden = false;              // no decision yet -> ask
        } else {
          banner.hidden = true;
          withdraw.hidden = false;            // already decided -> offer withdrawal only
        }
      }

      function apply(state) {
        var a = api();
        if (!a || typeof a.setConsent !== 'function') return;
        a.setConsent(state);
        banner.hidden = true;
        withdraw.hidden = false;
      }

      banner.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('[data-pa-consent]') : null;
        if (!btn) return;
        apply(btn.getAttribute('data-pa-consent'));
      });

      withdraw.addEventListener('click', function () {
        var a = api();
        if (!a) return;
        if (a.getConsent() === 'granted') {
          a.setConsent('denied');       // immediate: opt out, reset identity, clear storage
          withdraw.textContent = 'Analytics is off — turn back on';
        } else {
          a.setConsent('granted');
          withdraw.textContent = 'Change analytics choice';
        }
      });

      // The loader announces readiness on `document`; that is the reliable trigger
      // regardless of script order.
      document.addEventListener('portfolioanalytics:ready', decide);
      document.addEventListener('portfolioanalytics:consent', decide);

      // If the loader already finished before this ran, decide now.
      if (api()) { decide(); }
      // ...and if it never arrives (blocked or failed), still decide honestly.
      setTimeout(function () { if (!decided) decide(); }, 1500);
    })();
    </script>
  </body>
</html>
