{
  "name": "barcelona-compare",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate:local": "npx --yes wrangler d1 migrations apply barcelona-compare-registry --local",
    "db:migrate:remote": "npx --yes wrangler d1 migrations apply barcelona-compare-registry --remote",
    "registry:smoke": "bash scripts/registry-smoke.sh",
    "rebuild:smoke": "bash scripts/rebuild-smoke.sh",
    "badge:e2e": "node scripts/badge-freshness-e2e.mjs",
    "analytics:smoke": "bash scripts/analytics-smoke.sh",
    "owner:smoke": "bash scripts/owner-edit-smoke.sh",
    "registry:snapshot": "node scripts/registry-snapshot.mjs",
    "data:smoke": "python3 scripts/data-pipeline-smoke.py",
    "data:status": "python3 scripts/broaden.py status"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.6",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
